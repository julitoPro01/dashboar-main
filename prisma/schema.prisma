// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// =============================================
// 1. CORE & CONFIGURATION
// =============================================

model SystemConfig {
  id          Int      @id @default(autoincrement())
  section     String
  key         String   @unique
  value       String
  dataType   ConfigDataType
  isEncrypted Boolean @default(false)
  description String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime? @updatedAt

  createdBy String
  createdById Int
  updatedBy String?
  updatedById Int?

  creator UserAuthentication? @relation(fields: [createdById], references: [id],name: "CreatedSystemConfigs")
  updater UserAuthentication? @relation(fields: [updatedById], references: [id],name: "UpdatedSystemConfigs")

  @@unique([section, key])
  @@map("system_config")
}

enum ConfigDataType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  ARRAY
}

model FeatureFlag {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  description  String?
  isEnabled   Boolean  @default(false)
  targetUsers Json?    // {include: [1,2,3], exclude: [4,5,6]}
  percentage   Int?     // Rollout percentage
  conditions   Json?    // Conditional logic

  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt


  @@map("feature_flags")
}

// =============================================
// 2. AUDIT & LOGGING
// =============================================

model AuditLog {
  id               Int       @id @default(autoincrement())
  level            LogLevelType
  entity           String
  entityId        Int?
  action           String    // CREATE, UPDATE, DELETE
  previousData    Json?
  newData         Json?
  ipAddress       String?
  userAgent       String?
  createdBy       String

  createdAt       DateTime  @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([level])
  @@map("audit_logs")
}

enum LogLevelType {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

model SystemLog {
  id         Int      @id @default(autoincrement())
  key        String   @unique @db.VarChar(500)
  value      Json
  expiresA DateTime
  entityType String
  entityId   Int?
  
  @@index([expiresA])
  @@index([entityType, entityId])
  @@map("system_cache")
}

// =============================================
// 3. COMPANY & APPLICATION
// =============================================

model Company {
  id               Int     @id @default(autoincrement())
  legalName       String?
  commercialName  String?
  taxId           String?  // RUC
  fiscalAddress   String?
  phone            String?
  email            String?
  logoUrl         String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime? @updatedAt

  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?

  @@index([commercialName])
  @@index([legalName])
  @@index([taxId])
  @@map("companies")
}

// =============================================
// 4. AUTHENTICATION & USERS
// =============================================

model User {
  id               Int       @id @default(autoincrement())
  firstName       String
  lastName        String
  email            String?
  phone            String?
  documentType    String?
  documentNumber  String?
  publicId        String    @unique @default(uuid())
  profilePicture  String?
  lastOrderDate  DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime?  @updatedAt

  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?

  // Relations
  reviews          ProductReview[]
  authentication   UserAuthentication[]
  shoppingCarts            ShoppingCart[]
  addresses        UserAddress[]
  wishlists        UserWishlist[]
  paymentMethods  PaymentMethod[]
  orders           Order[]
  userPreferences UserPreferences?
  notifications    UserNotification[]
  promotionUses   PromotionUse[]
  mediaFile  MediaFile[]
  
@@index([lastName, firstName])
@@index([email])
@@index([phone])
@@index([isDeleted])
@@index([lastOrderDate])

  @@map("users")
}

model UserAuthentication {
  id                     Int           @id @default(autoincrement())
  userId                Int?
  supplierUserId       Int?
  verificationStatusId Int
  email                  String
  phone                  String?
  passwordHash          String
  failedAttempts        Int?          @default(0)
  authMethod            AuthMethodType
  primaryRole         RoleType
  verificationToken     String?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime?     @updatedAt

  isDeleted             Boolean       @default(false)
  deletedAt             DateTime?

  recordStatusId Int
  recordStatus RecordStatus @relation(fields: [recordStatusId], references: [id])

 // Relations
  userRoles      UserRole[]
  userSessions   UserSession[]
  statusChangesHistory  StatusChangeHistory[]

  createdBy String
  createdById Int?
  updatedBy String?
  updatedById Int?

  creator UserAuthentication? @relation("UserCreatedBy",fields: [createdById], references: [id])
  updater UserAuthentication? @relation("UserUpdatedBy",fields: [updatedById], references: [id])

  createdUsers UserAuthentication[] @relation("UserCreatedBy")
  updatedUsers UserAuthentication[] @relation("UserUpdatedBy")

  createdAddress UserAddress[] @relation("AddressCreatedBy")
  updatedAddress UserAddress[] @relation("AddressUpdatedBy")

  createdCurrency Currency[] @relation("CurrencyCreatedBy")
  updatedCurrency Currency[] @relation("CurrencyUpdatedBy")

  createdProduct Product[] @relation("ProductCreatedBy")
  updatedProduct Product[] @relation("ProductUpdatedBy")

  createdVariant ProductVariant[] @relation("VariantCreatedBy")
  updatedVariant ProductVariant[] @relation("VariantUpdatedBy")

  createdCategory Category[] @relation("CategoryCreatedBy")
  updatedCategory Category[] @relation("CategoryUpdatedBy")

  createdAttrDef AttributeDefinition[] @relation("AttrDefinitionCreatedBy")
  updatedAttrDef AttributeDefinition[] @relation("AttrDefinitionUpdatedBy")

  createdShipping Shipping[] @relation("ShippingCreatedBy")
  updatedShipping Shipping[] @relation("ShippingUpdatedBy")

  createdOrder Order[] @relation("OrderCreatedBy")
  updatedOrder Order[] @relation("OrderUpdatedBy")

  createdInvoice Invoice[] @relation("InvoiceCreatedBy")
  updatedInvoice Invoice[] @relation("InvoiceUpdatedBy")

  createdPaymentMethod PaymentMethod[] @relation("PaymentMethodCreatedBy")
  updatedPaymentMethod PaymentMethod[] @relation("PaymentMethodUpdatedBy")

  createdSupplier Supplier[] @relation("SupplierCreatedBy")
  updatedSupplier Supplier[] @relation("SupplierUpdatedBy")

  createdSupplierProduct SupplierProduct[] @relation("SupplierProductCreatedBy")
  updatedSupplierProduct SupplierProduct[] @relation("SupplierProductUpdatedBy")

  createdPromotion Promotion[] @relation("PromotionCreatedBy")
  updatedPromotion Promotion[] @relation("PromotionUpdatedBy")

  createdFeaturedAd featuredAd[] @relation("FeaturedAddCreatedBy")
  updatedFeaturedAd featuredAd[] @relation("FeaturedAddUpdatedBy")
 
  createdSystemConfigs SystemConfig[] @relation("CreatedSystemConfigs")
  updatedSystemConfigs SystemConfig[] @relation("UpdatedSystemConfigs")

  user User? @relation(fields: [userId], references: [id])
  supplierUser   SupplierUser?       @relation(fields: [supplierUserId], references: [id])
  verificationStatus VerificationStatus @relation(fields: [verificationStatusId], references: [id])



@@unique([email, authMethod])

@@unique([userId])
@@unique([supplierUserId])

@@index([email])
@@index([phone])
@@index([verificationStatusId])
@@index([isDeleted])

  @@map("user_authentications")
}

model UserSession {
  id                     Int       @id @default(autoincrement())
  authId                Int
  sessionToken          String    @unique
  startTime             DateTime  @default(now())
  lastActivity          DateTime? @default(now())
  isOnline              Boolean   @default(true)
  ipAddress             String?
  device                 String?
  browser                String?

  userAuthentication UserAuthentication @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([authId])
  @@map("user_sessions")
}

model UserPreferences {
  userId                    Int     @id
  preferredPaymentMethod   String?
  notificationPreferences   Boolean? @default(true)
  preferredSize             String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_preferences")
}

// =============================================
// 5. ROLES & PERMISSIONS (RBAC)
// =============================================

model Role {
  id           Int        @id @default(autoincrement())
  name         RoleType   @unique
  description  String?
  level        Int        @default(0) // Para jerarquía
  
  userRoles    UserRole[]
  permissions  RolePermission[]

  @@map("roles")
}

model UserRole {
  authId Int
  roleId Int
  
  userAuthentication UserAuthentication @relation(fields: [authId], references: [id], onDelete: Cascade)
  role                Role                @relation(fields: [roleId], references: [id])

  @@id([authId, roleId])
  @@map("user_roles")
}

model Permission {
  id          Int    @id @default(autoincrement())
  resource    String // 'Product', 'User', 'Order'
  action      String // 'read', 'write', 'delete', 'approve'
  description String?
  
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  conditions    Json? // Conditional permissions
  
  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum RoleType {
  // Sistema
  SUPER_ADMIN        // Dueño/creador
  SYSTEM_ADMIN       // Configuración técnica
  
  // Plataforma
  PLATFORM_ADMIN     // Admin de toda la plataforma
  PLATFORM_MANAGER   // Gestión operativa
  
  // Proveedores (Supplier)
  SUPPLIER_ADMIN     // Dueño/admin del proveedor
  SUPPLIER_MANAGER   // Encargado general
  SUPPLIER_SALES     // Ventas del proveedor
  SUPPLIER_INVENTORY // Inventario del proveedor
  SUPPLIER_SUPPORT   // Soporte del proveedor
  SUPPLIER_FINANCE   // Finanzas del proveedor
  
  //  STORE (Tiendas / sucursales)
  STORE_OWNER               // Dueño de tienda
  STORE_MANAGER          // Jefe de tienda
  STORE_STAFF               // Personal general
  STORE_CASHIER          // Caja / POS
  STORE_INVENTORY      // Control de stock interno

  // Clientes
  CUSTOMER           // Cliente regular
  VIP_CUSTOMER       // Cliente VIP/premium
  
  // Staff interno
  SUPPORT_AGENT      // Soporte al cliente
  WAREHOUSE_MANAGER  // Jefe de bodega
  WAREHOUSE_STAFF    // Personal de bodega
  MARKETING_MANAGER  // Jefe de marketing
  MARKETING_AGENT    // Ejecutivo de marketing
  
  // Otros
  AFFILIATE          // Afiliado
  GUEST              // Invitado
}

enum AuthMethodType {
  EMAIL
  GOOGLE
  FACEBOOK
  APPLE
  PHONE
}


// =============================================
// 6. ADDRESS & LOCATION
// =============================================

model UserAddress {
  id              Int       @id @default(autoincrement())
  userId         Int?
  country         String?
  addressLine    String?
  department      String?
  province        String?
  district        String?
  phone           String?
  type            String?
  firstName      String?
  lastName       String?
  documentType   String?
  documentNumber String?
  postalCode     String?
  isDefault      Boolean?  @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime?  @updatedAt

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?

  createdBy String
  createdById Int
  updatedBy String?
  updatedById Int?

  creator UserAuthentication? @relation(fields: [createdById], references: [id],name: "AddressCreatedBy")
  updater UserAuthentication? @relation(fields: [updatedById], references: [id],name: "AddressUpdatedBy")


  user            User? @relation(fields: [userId], references: [id])
  invoices        Invoice[]
  paymentMethods PaymentMethod[]
  ordersBilling  Order[] @relation("order_billing_address")
  ordersShipping Order[] @relation("order_shipping_address")

  @@index([userId])
  @@map("user_addresses")
}

// =============================================
// 7. CURRENCY & INTERNATIONALIZATION
// =============================================

model Currency {
  id           Int      @id
  code         String   @unique // USD, PEN, EUR
  name         String
  symbol       String
  exchangeRate Decimal @default(1.0) @db.Decimal(10,4)
  isPrimary   Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt

  createdBy String?
  createdById Int?
  updatedBy String?
  updatedById Int?

  creator UserAuthentication? @relation(fields: [createdById], references: [id],name: "CurrencyCreatedBy")
  updater UserAuthentication? @relation(fields: [updatedById], references: [id],name: "CurrencyUpdatedBy")

  dailySalesSummary DailySalesSummary[]
  paymentMethod PaymentMethod[]
  invoices Invoice[]
  order Order[]
  product Product[]

  @@map("currencies")
}

// =============================================
// 8. PRODUCT CATALOG
// =============================================

model Product {
  id                   Int       @id @default(autoincrement())
  supplierId          Int
  categoryId          Int
  verificationStatusId Int
  name                 String
  publicId            String    @unique @default(uuid())
  parentSku           String @unique
  longDescription     String? @db.Text
  shortDescription    String  @db.VarChar(300)
  slug                 String    @unique
  currencyId          Int       @default(1) // Default Currency

  createdAt           DateTime @default(now())
  updatedAt           DateTime? @updatedAt
  deletedAt           DateTime?

  extraAttributes        Json?

  recordStatusId Int  
  recordStatus RecordStatus @relation(fields: [recordStatusId], references: [id])

  saleStatusId Int
  saleStatus SaleStatus @relation(fields: [saleStatusId], references: [id])

  inventoryStatusId Int
  inventoryStatus InventoryStatus @relation(fields: [inventoryStatusId], references: [id])
  
  createdBy String
  createdById Int
  updatedBy String?
  updatedById Int?

  creator UserAuthentication? @relation(fields: [createdById], references: [id],name: "ProductCreatedBy")
  updater UserAuthentication? @relation(fields: [updatedById], references: [id],name: "ProductUpdatedBy")
  // Relations
  attributeValues        ProductAttributeValue[]
  wishlistItems          WishlistItem[]
  featuredAds            FeaturedAdItem[]
  reviews                 ProductReview[]
  supplier                Supplier              @relation(fields: [supplierId], references: [id])
  verificationStatus     VerificationStatus      @relation(fields: [verificationStatusId], references: [id])
  category              Category @relation(fields: [categoryId],references: [id])
  images                  ProductImage[]
  movies                  ProductMovie[]
  productVariants                ProductVariant[]
  shippingTimes          ProductShippingTime[]
  statistics              ProductStatistics[]
  promotions              Promotion[]
  supplierProducts       SupplierProduct[]

  currency                Currency                 @relation(fields: [currencyId], references: [id])
  productSearchIndex ProductSearchIndex?

@@index([supplierId, recordStatusId])

@@index([saleStatusId])
@@index([inventoryStatusId])


@@index([deletedAt])
@@index([recordStatusId])
@@index([supplierId])
@@index([verificationStatusId])


  @@map("products")
}

model ProductVariant {
  id              Int             @id @default(autoincrement())
  productId      Int
  sku             String          @unique
  barcode String? @unique
  
  stockQuantity  Int
  minStock       Int?
  price           Decimal         @db.Decimal(10,2)
  discount        Decimal         @default(0.00) @db.Decimal(5,2)
  isMainVariant Boolean         @default(false)
  displayOrder   Int
  isUnique       Boolean         @default(false)
  tags            ProductTag[]    @default([])

  createdAt      DateTime        @default(now())
  updatedAt      DateTime?       @updatedAt
  deletedAt      DateTime?  

  recordStatusId Int  
  recordStatus RecordStatus @relation(fields: [recordStatusId], references: [id])

  saleStatusId Int
  saleStatus SaleStatus @relation(fields: [saleStatusId], references: [id])

  inventoryStatusId Int
  inventoryStatus InventoryStatus @relation(fields: [inventoryStatusId], references: [id])

  createdBy String
  createdById Int
  updatedBy String?
  updatedById Int?

  creator UserAuthentication? @relation(fields: [createdById], references: [id],name: "VariantCreatedBy")
  updater UserAuthentication? @relation(fields: [updatedById], references: [id],name: "VariantUpdatedBy")

  supplierProducts     SupplierProduct[]
  varianAttributesValue    VariantAttributeValue[]
  cartItems            CartItem[]
  invoiceItems         InvoiceItem[]
  orderItems           OrderItem[]
  images                ProductImage[]
  movies                ProductMovie[]
  product               Product              @relation(fields: [productId], references: [id])
  stockMovements       StockMovement[]

@@index([productId, deletedAt])
@@index([productId, price])
@@index([productId, stockQuantity])
@@index([productId])
@@index([productId, recordStatusId])
@@index([recordStatusId])
@@index([saleStatusId])
@@index([inventoryStatusId])
@@index([productId, isMainVariant])

  @@map("product_variants")
}


model RecordStatus{
  id Int @id 
  name RecordStatusType

  productVariants ProductVariant[]
  products Product[]
  Categories Category[]
  suppliers  Supplier[]
  supplierUsers   SupplierUser[]
  userAuthenticatios UserAuthentication[]
  @@map("record_status")
}

enum RecordStatusType {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
  DELETED
}

model SaleStatus{
  id Int @id
  name SaleStatusType
  productVariants ProductVariant[]
  products Product[]
  @@map("sales_status")
}

enum SaleStatusType {
  AVAILABLE
  COMING_SOON
  DISCONTINUED
  MADE_TO_ORDER
}

model InventoryStatus{
  id Int @id
  name InventoryStatusType
  productVariants ProductVariant[]
  products Product[]
  @@map("inventory_status")
}

enum InventoryStatusType {
  IN_STOCK
  OUT_OF_STOCK
  PENDING_RESTOCK
  IN_TRANSIT
  RESERVED
}

enum ProductTag {
  ON_SALE
  NEW
  POPULAR
  LOW_STOCK
  IN_STORE_ONLY
}

// =============================================
// 9. CATEGORIES & ATTRIBUTES
// =============================================

model Category {
  id                  Int        @id @default(autoincrement())
  publicId           String     @default(uuid())
  name                String
  description         String?
  slug                String
  imageUrl           String?

  createdAt          DateTime   @default(now())
  updatedAt          DateTime?  @updatedAt

  path String
  level Int

  parentId           Int?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")  

  recordStatusId Int
  recordStatus RecordStatus @relation(fields: [recordStatusId], references: [id]) 

  createdBy String
  createdById Int
  updatedBy String?
  updatedById Int?

  creator UserAuthentication? @relation(fields: [createdById], references: [id],name: "CategoryCreatedBy")
  updater UserAuthentication? @relation(fields: [updatedById], references: [id],name: "CategoryUpdatedBy")

  // productCategories ProductCategory[]
  products Product[]
  promotions         Promotion[]
  categoryAttributes CategoryAttribute[]

  @@index([slug])
  @@index([recordStatusId])
  @@index([path])
  @@index([level])
  @@map("categories")
}


model AttributeDefinition {
  id           Int          @id @default(autoincrement())
  name         String @unique
  dataType    AttributeDataType
  description  String?
  isActive    Boolean      @default(false)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime?    @updatedAt

  createdBy String
  createdById Int?
  updatedBy String?
  updatedById Int?

  creator UserAuthentication? @relation(fields: [createdById], references: [id],name: "AttrDefinitionCreatedBy")
  updater UserAuthentication? @relation(fields: [updatedById], references: [id],name: "AttrDefinitionUpdatedBy")

  categoryAttributes CategoryAttribute[]
  systemAttributeValue SystemAttributeValue[]
  variantAttributeValues VariantAttributeValue[]
  productAttributeValues ProductAttributeValue[] 

  @@map("attribute_definitions")
}

model CategoryAttribute {
  id                     Int @id @default(autoincrement())
  categoryId            Int
  attributeDefinitionId Int

  isRequired        Boolean // True = mandatory
  isFilter          Boolean @default(false)
  isVariant Boolean @default(false)
  displayOrder      Int?
  displayGroup           DisplayGroup @default(GENERAL)

  category           Category           @relation(fields: [categoryId], references: [id], onDelete:Cascade)
  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id])

  @@unique([categoryId, attributeDefinitionId])
  @@map("category_attributes")
}

enum DisplayGroup {
    GENERAL 
    FEATURES
    DIMENSIONS
    TECHNICAL
    COMPATIBILITY
    PACKAGE_CONTENT
    WARRANTY
    ADDITIONAL
}

model ProductAttributeValue {
  id  Int @id @default(autoincrement())
  productId             Int
  product            Product            @relation(fields: [productId], references: [id])

 // Atributo definido por el sistema
  attributeDefinitionId Int?
  attributeDefinition AttributeDefinition? @relation(fields: [attributeDefinitionId], references: [id])

 // Atributo personalizado exclusivo del producto
  customName String?

 // Para valores libres
  valueText     String?
  valueNumber   Float?
  valueBoolean  Boolean?
  valueDate     DateTime?
  valueOptionIds      Int[] @default([])

  @@unique([productId, attributeDefinitionId])
  @@map("product_attribute_values")
}

model SystemAttributeValue{
  id Int @id @default(autoincrement())
  attributeDefinitionId Int
  value String
  displayOrder Int?


  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete:Cascade)

  @@unique([attributeDefinitionId,value])

  @@map("system_attribute_values")
}
model VariantAttributeValue {
  id Int @id @default(autoincrement())
  variantId             Int

  productVariant            ProductVariant    @relation(fields: [variantId], references: [id])

  attributeDefinitionId Int?
  attributeDefinition AttributeDefinition? @relation(fields: [attributeDefinitionId], references: [id])
  @@unique([variantId, attributeDefinitionId])
  @@index([attributeDefinitionId, valueText])

// Atributo personalizado exclusivo del producto
  customName String?

  // Para valores libres
  valueText     String? 
  valueNumber   Float?
  valueBoolean  Boolean?
  valueDate     DateTime?
  valueOptionIds      Int[] @default([]) // IDs de system attribute value

  @@map("variant_attribute_values")
}

enum AttributeDataType {
  TEXT
  LONG_TEXT
  NUMBER
  DECIMAL
  BOOLEAN
  DATE
  SELECT
  MULTISELECT
  COLOR
  URL
  EMAIL
  PHONE
}

