
model ProductImage {
  id          Int  @id  @default(autoincrement())
  variantId  Int?
  productId  Int?
  fileId     Int  @unique
  description String?
  isPrimary  Boolean
  isFeatured  Boolean  @default(false)  // ← Para slider/promociones
  displayOrder Int
  featuredOrder Int?                    // ← Orden específico en slider

  product       Product?       @relation(fields: [productId], references: [id])
  productvariant       ProductVariant? @relation(fields: [variantId], references: [id])
  mediaFile    MediaFile     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([productId,fileId])
  @@index([variantId,fileId])
  @@map("product_images")
}

model ProductMovie {
  id          Int  @id @default(autoincrement())
  fileId     Int  @unique
  variantId  Int?
  productId  Int?
  description String?
  isPrimary  Boolean
  displayOrder Int

  product       Product?       @relation(fields: [productId], references: [id])
  productvariant       ProductVariant? @relation(fields: [variantId], references: [id])
  mediaFile    MediaFile     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@map("product_movies")
}

model MediaFile {
  id           Int      @id @default(autoincrement())
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  bucket       String?  // For cloud storage
  isPublic    Boolean  @default(true)
  metadata     Json?
  uploadedBy  Int?
  uploadedAt  DateTime @default(now())


  uploadedByUser User? @relation(fields: [uploadedBy], references: [id])
  productImage ProductImage?
  productMovie ProductMovie?
  reviewImage ReviewImage[]

  @@map("media_files")
}

model ReviewImage {
  id         Int      @id @default(autoincrement())
  reviewId  Int
  fileId    Int
  isPrimary Boolean  @default(false)

  createdAt DateTime @default(now())

  review     ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  mediaFile MediaFile     @relation(fields: [fileId], references: [id])

  @@index([reviewId])
  @@map("review_images")
}
